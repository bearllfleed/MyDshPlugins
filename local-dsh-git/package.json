{
  "name": "@local/dsh-git",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "VSCode-style Git source control for DeepSeekRuntime: multi-repository discovery, right-sidebar tab, commit, branches, history, diff and sync.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "git/*.js",
    "locale/*.json",
    "icon.svg",
    "CONTRACT.md",
    "README.md",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
